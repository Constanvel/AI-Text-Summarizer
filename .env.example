# Salin file ini jadi .env, lalu isi dengan key asli.
# Ambil key gratis di https://console.groq.com/keys
#
# CATATAN: app ini murni static (tanpa backend), jadi browser TIDAK membaca .env.
# Key dimasukkan lewat panel "Groq API Key" di halaman dan disimpan di localStorage.
# File ini jadi acuan nama variabel kalau nanti ditambah backend/build step.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
